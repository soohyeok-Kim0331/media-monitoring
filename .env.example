# 이 파일을 복사해서 이름을 '.env' 로 바꾼 뒤, 아래 값을 실제 키로 채우세요.
#
#   PowerShell:  Copy-Item .env.example .env
#
# .env 는 .gitignore 에 걸려 있어 GitHub에 올라가지 않습니다.
# (.env.example 인 이 파일은 키가 없으므로 올라가도 안전합니다)
#
# 키 발급: https://console.anthropic.com  ->  API keys  ->  Create Key

ANTHROPIC_API_KEY=sk-ant-여기에-발급받은-키를-붙여넣으세요

# 선택: 사용할 모델을 바꾸고 싶을 때만 주석을 해제하세요.
# ANTHROPIC_MODEL=claude-sonnet-5
